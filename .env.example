# Base URL of your reverse proxy. Leave empty to send requests directly.
# Point this at your proxy to bypass CORS, e.g. VITE_REVERSE_PROXY_URL=https://proxy.example.com
VITE_REVERSE_PROXY_URL=

# Pre-filled URL for a brand new request.
VITE_DEFAULT_TARGET_URL=https://jsonplaceholder.typicode.com/todos/1